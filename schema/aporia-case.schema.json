{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trivianfield.org/schemas/aporia-case.schema.json",
  "title": "Aporia Hermeneutic Case",
  "type": "object",
  "required": ["interpretations"],
  "properties": {
    "context": {"type": "string"},
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "claims"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "kind", "source", "confidence"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "kind": {
                  "enum": ["observed", "inferred", "interpreted", "somatically_reported", "symbolic", "speculative", "unknown"]
                },
                "source": {"type": "string", "minLength": 1},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "supports": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "contradicted_by": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
